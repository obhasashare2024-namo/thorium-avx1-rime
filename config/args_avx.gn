is_official_build = true
is_debug = false
symbol_level = 0
enable_nacl = false
blink_symbol_level = 0
target_cpu = "x64"

# Thorium AVX (Sandy Bridge / Ivy Bridge) Compiler Flags
is_thorium = true
use_vaapi = true
enable_widevine = true
enable_hangout_services_extension = true
treat_warnings_as_errors = false

# Target toolchain configuration
custom_toolchain = "//build/toolchain/linux:clang_x64_target"
host_toolchain = "//build/toolchain/linux:clang_x64"
x86_arch = "sandybridge"
use_thin_lto = true
